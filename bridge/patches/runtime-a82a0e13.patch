+///   2. 代理**已开启**：本应点掉，但点击未生效时同样静默通过 → Copilot 会在代理作战
+///      模式下开打，游戏用内置代理记录顶替玩家作业（数据工厂拿到的是错轨迹）；
+///   3. 页面异常/模板不匹配 → 同样静默。
+/// 本方法先判状态再动作，每次判定都通过 SubTaskExtraInfo(what=CopilotPrtsState) 上报；
+/// 判定为"已开启"时点掉并复验，3 次仍开启则发 SubTaskError(what=CopilotPrtsToggleFailed)
+/// 并让本次 Copilot 失败——即"失败可见，不允许静默跳过"。
+bool asst::MultiCopilotTaskPlugin::ensure_prts_disabled()
+{
+    const auto matched = [&](const std::string& task_name) {
+        PipelineAnalyzer match(ctrler()->get_image());
+        match.set_tasks({ task_name });
+        return match.analyze().has_value();
+    };
+    const auto notify = [&](const char* state_before, const char* state_after, const char* note) {
+        json::value info = basic_info_with_what("CopilotPrtsState");
+        info["details"]["state_before"] = state_before;
+        info["details"]["state_after"] = state_after;
+        info["details"]["note"] = note;
+        callback(AsstMsg::SubTaskExtraInfo, info);
+    };
+
+    bool agent_on = matched("NotUsePrts");
+    const bool agent_off_btn = matched("UsePrts");
+
+    if (!agent_on) {
+        if (agent_off_btn) {
+            Log.info(__FUNCTION__, "agent battle is OFF at briefing page (UsePrts button present)");
+            notify("off", "off", "use_prts_button_present");
+        }
+        else {
+            // 两者都不匹配 = 状态未知：保留上游"继续执行"的语义（避免误伤没有该按钮的
+            // 关卡），但必须可见，不能无声跳过。
+            Log.warn(__FUNCTION__, "PRTS toggle state unknown: neither UsePrts nor NotUsePrts matched");
+            notify("unknown", "unknown", "prts_button_not_found");
+        }
+        return true;
+    }
+
+    Log.warn(__FUNCTION__, "agent battle is ON at briefing page, turning it off");
+    for (int attempt = 0; attempt < 3 && agent_on; ++attempt) {
+        ProcessTask(*this, { "NotUsePrts" }).set_retry_times(0).run();
+        sleep(Config.get_options().task_delay);
+        agent_on = matched("NotUsePrts");
+    }
+
+    if (agent_on) {
+        Log.error(__FUNCTION__, "failed to turn off agent battle: NotUsePrts still matched after 3 attempts");
+        notify("on", "on", "toggle_failed");
+        json::value err = basic_info_with_what("CopilotPrtsToggleFailed");
+        err["details"]["reason"] = "agent battle still ON after clicking NotUsePrts 3 times";
+        callback(AsstMsg::SubTaskError, err);
+        return false;
+    }
+
+    notify("on", "off", "turned_off");
+    return true;
+}
