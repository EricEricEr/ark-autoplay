 using namespace asst::battle;
 
+// [PATCH 0003] BattleState 探针。
+//
+// 目的：patch 0001 已把 costs/kills 写进 BattleState 回调，但实测恒 0。要区分
+// 「update_* 根本没被调用」与「调用了但识别没成功」，只能在这两个函数内部打点。
+// 结果以逐行 JSON 追加到 debug/probe_battlestate.jsonl（相对进程 cwd，可用环境变量
+// ARK_BATTLESTATE_PROBE 覆盖为绝对路径），字段含 fn / n_cost / n_kills / has_result /
+// status_id / success / costs / kills / total_kills / has_prev / job_id(环境变量 ARK_JOB_ID)。
+// 只读既有成员与识别结果，不改动任何识别/决策逻辑。
+namespace
+{
+std::mutex s_probe_mutex;
+std::uint64_t s_probe_cost_calls = 0;
+std::uint64_t s_probe_kills_calls = 0;
+std::uint64_t s_probe_lines = 0;
+bool s_probe_open_failed_logged = false;
+
+// MSVC 下 std::getenv 会触发 C4996（本项目按错误处理），改用 _dupenv_s。
+std::string probe_env_value(const char* name)
+{
+#ifdef _MSC_VER
+    char* buffer = nullptr;
+    size_t size = 0;
+    if (_dupenv_s(&buffer, &size, name) != 0 || buffer == nullptr) {
+        return {};
+    }
+    std::string value(buffer);
+    free(buffer);
+    return value;
+#else
+    if (const char* value = std::getenv(name); value != nullptr) {
+        return std::string(value);
+    }
+    return {};
+#endif
+}
+
+std::filesystem::path probe_battlestate_file_path()
+{
+    const std::string env = probe_env_value("ARK_BATTLESTATE_PROBE");
+    if (!env.empty()) {
+        return std::filesystem::path(env);
+    }
+    return std::filesystem::path("debug") / "probe_battlestate.jsonl";
+}
+
+void probe_battle_state(
+    const char* fn,
+    bool has_result,
+    int status_id,
+    bool success,
+    int costs,
+    int kills,
+    int total_kills,
+    bool has_prev)
+{
+    std::lock_guard<std::mutex> lock(s_probe_mutex);
+    if (std::strcmp(fn, "update_cost") == 0) {
+        ++s_probe_cost_calls;
+    }
+    else {
+        ++s_probe_kills_calls;
+    }
+    if (s_probe_lines >= 200000) {
+        return;
+    }
+    ++s_probe_lines;
+
+    const auto path = probe_battlestate_file_path();
+    std::error_code ec;
+    if (!path.parent_path().empty()) {
+        std::filesystem::create_directories(path.parent_path(), ec);
+    }
+    std::ofstream ofs(path, std::ios::app | std::ios::binary);
+    if (!ofs) {
+        if (!s_probe_open_failed_logged) {
+            s_probe_open_failed_logged = true;
+            Log.error("BattleState probe: cannot open", path.string(), ec.message());
+        }
+        return;
+    }
+
+    const auto now_ms =
+        std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::system_clock::now().time_since_epoch())
+            .count();
+    const std::string job_id = probe_env_value("ARK_JOB_ID");
+    ofs << "{\"t_ms\":" << now_ms << ",\"fn\":\"" << fn << "\",\"n_cost\":" << s_probe_cost_calls
+        << ",\"n_kills\":" << s_probe_kills_calls << ",\"has_result\":" << (has_result ? "true" : "false")
+        << ",\"status_id\":" << status_id << ",\"success\":" << (success ? "true" : "false")
+        << ",\"costs\":" << costs << ",\"kills\":" << kills << ",\"total_kills\":" << total_kills
+        << ",\"has_prev\":" << (has_prev ? "true" : "false") << ",\"job_id\":\"" << job_id << "\"}\n";
+    ofs.flush();
+}
+}
