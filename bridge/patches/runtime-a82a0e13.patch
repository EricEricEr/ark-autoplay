+/// [PATCH 0001] 战场状态导出。只读取既有成员并序列化，不触碰识别逻辑。
+json::object asst::BattleHelper::battle_state_json() const
+{
+    json::object state;
+    state["in_battle"] = m_in_battle;
+    state["in_speedup"] = m_in_speedup;
+    state["costs"] = m_cost;
+    state["kills"] = m_kills;
+    state["total_kills"] = m_total_kills;
+    state["camera_count"] = m_camera_count;
+
+    // 待部署栏（手牌）：名字 / 职业 / 费用 / 是否可部署 / 是否冷却中 / 头像位置
+    json::array hand;
+    for (const auto& oper : m_cur_deployment_opers) {
+        hand.emplace_back(json::object {
+            { "index", static_cast<int64_t>(oper.index) },
+            { "name", oper.name },
+            // 职业用可读字符串（enum_to_string）而非裸整数：下游无需同步枚举定义
+            { "role", enum_to_string(oper.role) },
+            { "role_id", static_cast<int64_t>(oper.role) },
+            { "cost", oper.cost },
+            { "available", oper.available },
+            { "cooling", oper.cooling },
+            { "rect", json::array { oper.rect.x, oper.rect.y, oper.rect.width, oper.rect.height } },
+            { "is_usual_location", oper.is_usual_location },
+        });
+    }
+    state["hand"] = std::move(hand);
+
+    // 已部署干员：职业 + 名字 -> 棋盘格坐标（MaaCore 的 Point 是格子坐标而非像素）
+    json::array deployed;
+    for (const auto& [tag, loc] : m_battlefield_opers) {
+        deployed.emplace_back(json::object {
+            { "name", tag.name },
+            { "role", enum_to_string(tag.role) },
+            { "role_id", static_cast<int64_t>(tag.role) },
+            { "row", loc.y },
+            { "col", loc.x },
+        });
+    }
+    state["deployed"] = std::move(deployed);
+
+    // 关卡与镜头信息：供下游把格子坐标映射回像素
+    state["stage_name"] = m_stage_name;
+    state["camera_shift"] = json::array { m_camera_shift.first, m_camera_shift.second };
+
+    return state;
+}
